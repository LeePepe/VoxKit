#!/usr/bin/env bash
set -euo pipefail
root="$(git rev-parse --show-toplevel)"; cd "$root"
pin=838e10a059979e6732446cb26edc95d173cc7e3a
shared_ci="${SHARED_CI:-$root/.shared-ci}"
provider_git() (
  for name in $(git rev-parse --local-env-vars); do unset "$name"; done
  git -C "$shared_ci" "$@"
)
shared_ci="$(python3 -I -B -c '
import os
import pathlib
import sys
path = pathlib.Path(os.path.abspath(sys.argv[1]))
if path.is_symlink():
    raise SystemExit("provider path must not traverse a symlink")
print(path.parent.resolve() / path.name)
' "$shared_ci")"
if [ ! -e "$shared_ci" ]; then
  if [ -n "${SHARED_CI:-}" ]; then
    echo "[verify] supplied SHARED_CI must already exist at the declared pin" >&2; exit 1
  fi
  mkdir "$shared_ci"
  provider_git init -q
  provider_git fetch -q --depth=1 https://github.com/LeePepe/shared-ci.git "$pin"
  provider_git checkout -q --detach FETCH_HEAD
fi
if [ ! -d "$shared_ci" ] ||
   [ "$(provider_git rev-parse --show-toplevel 2>/dev/null || true)" != "$shared_ci" ] ||
   [ "$(provider_git rev-parse HEAD 2>/dev/null || true)" != "$pin" ]; then
  echo "[verify] preserve existing provider path; require a checkout at the declared pin" >&2; exit 1
fi
provider_git ls-files -v -z | python3 -I -B -c '
import sys
if any(not row.startswith(b"H ") for row in sys.stdin.buffer.read().split(b"\0") if row):
    raise SystemExit("[verify] preserve provider index flags; require an ordinary clean checkout")
'
status="$(provider_git status --porcelain --untracked-files=all --ignored)" || {
  echo "[verify] cannot inspect provider checkout; refusing to execute it" >&2; exit 1
}
if [ -n "$status" ]; then
  echo "[verify] preserve dirty provider checkout; supply a separate clean pinned checkout" >&2; exit 1
fi
context() { python3 -I -B "$shared_ci/scripts/context/_context.py" "$@"; }
policy() {
  context audit
  python3 -I -B "$shared_ci/scripts/lint/workflows.py" --root .
  if command -v gitleaks >/dev/null 2>&1; then gitleaks detect --log-opts="--all" --no-banner; elif [ "${VERIFY_MODE:-}" = ci ]; then echo "[verify] gitleaks required in CI" >&2; return 1; fi
  scripts/redlines/check.sh --self-test
  scripts/redlines/check.sh
}
mode=changed
layer=""
case "${1:-}" in
  --all) mode=all;; --changed|'') mode=changed;; --selected) mode=selected;; --policy) policy; exit;; --ios) scripts/ci/ios-simulator.sh; exit;; --layer) layer="${2:?layer required}"; mode=layer;; *) echo "usage: scripts/verify [--changed|--all|--selected|--policy|--layer Layer|--ios]" >&2; exit 2;;
esac
[ "$mode" = layer ] || policy
if [ "$mode" = all ]; then layers="$(context layers --all)"
elif [ "$mode" = selected ]; then layers="${CI_SELECTED_LAYERS:-$(context layers --all)}"
elif [ "$mode" = layer ]; then layers="$layer"
else
  base="${VERIFY_BASE:-origin/main}"; changed="$(git diff --name-only "$(git merge-base "$base" HEAD)" HEAD)"
  [ -n "$changed" ] || { echo "[verify] no changes"; exit 0; }
  layers="$(printf '%s\n' "$changed" | context layers --stdin)"
fi
for l in $layers; do context run "$l" --mode local; done
if [ "$mode" = all ] && [ "${RUN_IOS:-0}" = 1 ]; then scripts/ci/ios-simulator.sh; fi
echo "[verify] ok: $layers"
